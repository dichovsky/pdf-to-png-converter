{
    "name": "pdf-to-png-converter",
    "version": "4.3.0",
    "description": "Node.js utility to convert PDF file/buffer pages to PNG files/buffers. No build-time compilation required — pre-built native binaries included for all major platforms.",
    "keywords": [
        "pdf",
        "pdfparse",
        "pdf parse",
        "pdf-parse",
        "pdf to png",
        "pdf to image",
        "pdf file to image",
        "pdf buffer to image",
        "convert pdf to png",
        "pdf to png converter",
        "pdf to png cli"
    ],
    "homepage": "https://github.com/dichovsky/pdf-to-png-converter#readme",
    "bugs": {
        "url": "https://github.com/dichovsky/pdf-to-png-converter/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/dichovsky/pdf-to-png-converter.git"
    },
    "funding": "https://buymeacoffee.com/dichovsky",
    "license": "MIT",
    "author": "Igor Magdich <magdich.igor@gmail.com>",
    "sideEffects": false,
    "type": "commonjs",
    "exports": {
        ".": {
            "types": "./out/index.d.ts",
            "require": "./out/index.js",
            "default": "./out/index.js"
        }
    },
    "main": "out/index.js",
    "types": "out/index.d.ts",
    "bin": {
        "pdf-to-png-converter": "out/cli.js"
    },
    "files": [
        "out"
    ],
    "scripts": {
        "prebuild": "npm run clean",
        "build": "tsc --pretty --project tsconfig.prod.json",
        "build:strict": "tsc --project tsconfig.strict.json",
        "bench": "npm run build && node scripts/benchmark.ts",
        "build:test": "tsc --pretty --noEmit --project tsconfig.json",
        "check": "npm run clean && npm run build:test && npm run build:strict && npm run format:check && npm run lint && npm run test:license && npm test",
        "clean": "node -e \"for (const dir of ['out', 'test-results']) require('node:fs').rmSync(dir, { recursive: true, force: true, maxRetries: 5, retryDelay: 100 })\"",
        "docker:build": "docker build --build-arg NODE_VERSION=$(cat .nvmrc) --compress -t test-pdf-to-png-converter .",
        "docker:run": "docker run --rm -it -v ${PWD}/test-results:/usr/pkg/test-results test-pdf-to-png-converter",
        "docker:test": "vitest run --coverage",
        "format": "oxfmt --write .",
        "format:check": "oxfmt --check .",
        "lint": "oxlint --type-aware --deny-warnings .",
        "preprepare": "husky",
        "prepublishOnly": "npm run check && npm run build",
        "release:precheck": "node scripts/release-precheck.ts",
        "release:postcheck": "node scripts/release-postcheck.ts",
        "test": "vitest run --coverage",
        "test:docker": "npm run clean && npm run docker:build && npm run docker:run",
        "test:fast": "vitest run --reporter=dot --no-coverage",
        "test:license": "node scripts/check-licenses.ts"
    },
    "lint-staged": {
        "*.{ts,cts,mts}": [
            "oxlint --type-aware --deny-warnings --fix",
            "oxfmt --write"
        ],
        "*.{js,mjs,cjs,json,md,yml,yaml}": "oxfmt --write"
    },
    "dependencies": {
        "@napi-rs/canvas": "~1.1.1",
        "pdfjs-dist": "~6.5.438"
    },
    "devDependencies": {
        "@types/node": "^26.6.6",
        "@vitest/coverage-v8": "^5.1.1",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.0",
        "oxfmt": "^0.79.0",
        "oxlint": "^1.94.0",
        "oxlint-tsgolint": "^7.0.2008",
        "png-visual-compare": "8.0.0",
        "spdx-satisfies": "^6.0.1",
        "typescript": "~7.0.2",
        "vitest": "^5.1.1"
    },
    "engines": {
        "node": ">=24"
    },
    "_packageFormatNote": "CJS-only — nodenext TS with .js specifiers is compatible.",
    "allowScripts": {
        "fsevents@2.3.3": true
    }
}
