{
    "$schema": "https://json.schemastore.org/tsconfig",
    "compilerOptions": {
        "lib": [
            "ES2024",
            "ESNext.Array",
            "ESNext.Collection",
            "ESNext.Iterator"
        ],
        "module": "nodenext",
        "target": "ES2024",
        "types": [
            "node"
        ],
        "rootDir": ".",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "declaration": false,
        "noEmit": true,
        "allowUnreachableCode": false,
        "allowImportingTsExtensions": true,
        "paths": {
            "pdf-to-png-converter": [
                "./src/index.ts"
            ]
        }
    },
    "include": [
        "src",
        "__tests__",
        "scripts",
        "vitest.config.mts"
    ]
}
