{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "trailingComma": "all",
    "tabWidth": 4,
    "semi": true,
    "singleQuote": true,
    "printWidth": 140,
    "useTabs": false,
    "arrowParens": "always",
    "sortPackageJson": false,
    "ignorePatterns": [
        "out/**",
        "test-results/**",
        "bench-results/**",
        "coverage/**",
        ".claude/**",
        "package-lock.json"
    ]
}
